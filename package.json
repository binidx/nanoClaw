{
  "name": "nanoclaw",
  "version": "1.2.6",
  "description": "Personal Claude assistant. Lightweight, secure, customizable.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "nanoclaw": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-runtime-assets.mjs",
    "build:web": "cd web && npm run build",
    "build:all": "tsc && cd web && npm run build",
    "check": "npm run format:check && npm run check:loc && npm run check:docs:paths && npm run build && npm run build:web && npm run test:critical && npm run check:memory",
    "check:loc": "node scripts/check-loc.mjs --max 700",
    "check:docs:paths": "node scripts/check-doc-paths.mjs",
    "check:feature-map:freshness": "node scripts/check-feature-map-freshness.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "cli:dev": "tsx src/cli.ts",
    "nanoclaw": "node dist/cli.js",
    "onboard": "node dist/cli.js onboard",
    "doctor": "node dist/cli.js doctor",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\" \"web/src/**/*.ts\" \"web/src/**/*.tsx\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"web/src/**/*.ts\" \"web/src/**/*.tsx\"",
    "prepare": "husky",
    "setup": "tsx setup/index.ts",
    "auth": "node scripts/auth-info.mjs",
    "test": "vitest run",
    "test:critical": "vitest run src/doctor.test.ts src/provider-api.test.ts src/web-auth-runtime.test.ts src/config-store.test.ts",
    "test:memory": "vitest run --maxWorkers=1 src/memory-config.test.ts src/memory-observability.test.ts src/memory-compaction-worker.test.ts src/memory-promotion.test.ts src/internal-memory-routes.test.ts src/memory-identity.test.ts src/memory-search-index.test.ts src/memory-document-indexing.test.ts src/context-budget-assembly.test.ts src/db.test.ts src/context-assembly.test.ts src/agent-memory-tools.test.ts src/agent-runner.test.ts src/codex-mcp-tools.test.ts",
    "check:memory": "npm run test:memory",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.60.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@types/pg": "^8.20.0",
    "adm-zip": "^0.5.17",
    "better-sqlite3": "^12.6.2",
    "cheerio": "^1.2.0",
    "cron-parser": "^5.5.0",
    "express": "^5.2.1",
    "i18next": "^26.0.8",
    "jsdom": "^29.0.2",
    "jszip": "^3.10.1",
    "ldapts": "^8.1.7",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "mysql2": "^3.20.0",
    "nanoid": "^5.1.7",
    "node-pty": "^1.1.0",
    "pg": "^8.20.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "tar": "^7.5.11",
    "tree-sitter-wasms": "^0.1.13",
    "turndown": "^7.2.4",
    "unpdf": "^1.6.0",
    "ws": "^8.19.0",
    "xlsx": "^0.18.5",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "overrides": {
    "picomatch": "^4.0.4",
    "path-to-regexp": "^8.4.2",
    "axios": "^1.15.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.18",
    "husky": "^9.1.7",
    "light-my-request": "^6.6.0",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18",
    "web-tree-sitter": "^0.26.8"
  },
  "engines": {
    "node": ">=20"
  }
}
