
# Container mode: "docker" (default) or "direct" (no Docker needed)
# CONTAINER_MODE=direct

# Database engine: "sqlite" (default), "mysql", or "postgres"
# DB_ENGINE=sqlite

# MySQL connection (only needed when DB_ENGINE=mysql)
# DB_MYSQL_HOST=localhost
# DB_MYSQL_PORT=3306
# DB_MYSQL_USER=nanoclaw
# DB_MYSQL_PASSWORD=
# DB_MYSQL_DATABASE=nanoclaw
# DB_MYSQL_POOL_SIZE=10

# PostgreSQL connection (only needed when DB_ENGINE=postgres)
# DB_PG_HOST=localhost
# DB_PG_PORT=5432
# DB_PG_USER=nanoclaw
# DB_PG_PASSWORD=
# DB_PG_DATABASE=nanoclaw
# DB_PG_POOL_SIZE=10
# DB_PG_SSL=false

# Cookie security: "true" | "false" | unset (auto-detect)
# Set to "false" for internal HTTP-only deployments (e.g. K8s without TLS)
# COOKIE_SECURE=false

# Feishu (飞书) - App credentials from open.feishu.cn
# FEISHU_APP_ID=cli_xxxx
# FEISHU_APP_SECRET=xxxx
# FEISHU_DOMAIN=feishu  # Optional: feishu (default) or lark (international)
