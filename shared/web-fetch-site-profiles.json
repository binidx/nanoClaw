[
  {
    "id": "cloud-tencent",
    "label": "Tencent Cloud Article",
    "profile": {
      "domains": ["cloud.tencent.com"],
      "pathPrefixes": ["/developer/article/"],
      "forceProvider": "browser_cli",
      "waitSelector": ".com-markdown-collpase-main,.article-detail__content,.J-articlePanel",
      "postWaitMs": 1500,
      "waitUntil": "domcontentloaded",
      "viewport": "1440x1200",
      "userAgent": ""
    }
  },
  {
    "id": "wechat-article",
