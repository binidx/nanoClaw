# NanoClaw Production Environment Configuration
# Copy this file to .env and fill in the values.

# ─── Database ────────────────────────────────────────────────────────
DB_ENGINE=postgres
DB_PG_HOST=postgres
DB_PG_PORT=5432
DB_PG_USER=nanoclaw
DB_PG_PASSWORD=changeme_pg_password
DB_PG_DATABASE=nanoclaw
DB_PG_POOL_SIZE=20
DB_PG_SSL=false

# ─── Encryption ──────────────────────────────────────────────────────
# 32-byte hex key for encrypting API keys at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ─── Web Server ──────────────────────────────────────────────────────
# WEB_PORT=3377
# TZ=Asia/Shanghai

# ─── Agent ───────────────────────────────────────────────────────────
# MAX_CONCURRENT_AGENTS=5
# AGENT_TIMEOUT=1800000
# IDLE_TIMEOUT=1800000

# ─── LLM Provider (system-level fallback when no user BYOK key) ─────
# AI_PROVIDER=claude
# ANTHROPIC_API_KEY=
# CODEX_API_KEY=

# ─── Channel tokens (legacy single-bot mode, prefer per-user UI) ────
# DISCORD_BOT_TOKEN=
# TELEGRAM_BOT_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
